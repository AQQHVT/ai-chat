# Ключ живёт только здесь, на сервере. В браузер он не попадает.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Одна или несколько бесплатных моделей через запятую.
# Если первая перегружена (429) или недоступна, OpenRouter сам попробует следующую.
# Актуальный список: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-small-3.2-24b-instruct:free

# Порт Node-сервера (Vite в dev-режиме проксирует /api сюда)
PORT=8787

# Для локальной проверки ошибок без ключа: npm run mock, затем раскомментируйте
# OPENROUTER_BASE_URL=http://127.0.0.1:8788/api/v1
